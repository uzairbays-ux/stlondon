{%- comment -%}
  Renders a KJ-style product card (Kylie reference anatomy):
  grey image tile with "+N shades" top-left and tag badge top-right,
  white info strip with stars, bold title + price row, grey subtitle.

  Accepts:
  - product: {Object} Product Liquid object
  - show_secondary_image: {Boolean} show second image on hover
  - text_color: {String} CSS color for the info text

  Usage:
  {% render 'kj-product-card', product: product, show_secondary_image: true, text_color: '#000000' %}
{%- endcomment -%}

{%- assign card_badge = '' -%}
{%- for tag in product.tags -%}
  {%- assign tag_down = tag | downcase -%}
  {%- if tag_down == 'best seller' or tag_down == 'bestseller' or tag_down == 'new' or tag_down == 'favorite' or tag_down == 'favourite' -%}
    {%- assign card_badge = tag_down | replace: 'bestseller', 'best seller' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="kj-product-card">
  <a href="{{ product.url }}" class="kj-product-card-link">
    <div class="kj-product-image-wrap">
      {%- if product.variants.size > 1 -%}
        <span class="kj-shades-inline">+{{ product.variants.size }} shades</span>
      {%- endif -%}

      {%- if card_badge != blank -%}
        <span class="kj-card-badge">{{ card_badge }}</span>
      {%- endif -%}

      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="kj-product-image kj-img-primary" loading="lazy" width="600" height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}">
        {%- if product.images[1] != blank and show_secondary_image -%}
          <img src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="kj-product-image kj-img-secondary" loading="lazy" width="600" height="{{ 600 | divided_by: product.images[1].aspect_ratio | round }}">
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'kj-product-placeholder' }}
      {%- endif -%}
    </div>

    <div class="kj-product-info" style="color: {{ text_color }};">
      {%- if product.variants.size > 1 -%}
        {%- assign dot_count = 0 -%}
        <div class="kj-swatch-row kj-card-dots">
          {%- for variant in product.variants -%}
            {%- if variant.featured_image != blank and dot_count < 5 -%}
              <span class="kj-swatch"><img src="{{ variant.featured_image | image_url: width: 60, height: 60, crop: 'center' }}" alt="" width="20" height="20" loading="lazy"></span>
              {%- assign dot_count = dot_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if product.variants.size > dot_count and dot_count > 0 -%}
            <span class="kj-swatch-more">+{{ product.variants.size | minus: dot_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- assign rating = product.metafields.reviews.rating.value.rating -%}
      {%- assign rating_count = product.metafields.reviews.rating_count -%}
      <div class="kj-stars{% if rating == blank %} kj-stars--placeholder{% endif %}" aria-hidden="true">
        {%- assign filled = rating | default: 5 | round -%}
        {%- for i in (1..5) -%}
          <span class="kj-star{% if i <= filled %} kj-star--filled{% endif %}">&#9733;</span>
        {%- endfor -%}
        {%- if rating_count != blank -%}
          <span class="kj-star-count">({{ rating_count }})</span>
        {%- endif -%}
      </div>

      <div class="kj-product-title-row">
        <h3 class="kj-product-title">{{ product.title }}</h3>
        <div class="kj-product-price">
          {%- if product.compare_at_price > product.price -%}
            <s class="kj-price-compare">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="kj-price-regular">{{ product.price | money }}</span>
        </div>
      </div>

      {%- if product.type != blank -%}
        <p class="kj-product-subtitle">{{ product.type | downcase }}</p>
      {%- endif -%}
    </div>
  </a>

  <div class="kj-card-reveal">
    <form action="{{ routes.cart_add_url }}" method="post" class="kj-card-add-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="kj-card-add" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}
          add to cart - {{ product.price | money }}
        {%- else -%}
          sold out
        {%- endif -%}
      </button>
    </form>
  </div>
</div>
