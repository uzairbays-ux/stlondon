{%- comment -%}
  Shared visual styles for kj-product-card. Rendered once per section that
  uses the card outside kj-product-slider (which carries its own copy).
  Container-specific sizing (.kj-product-card flex/width) stays in the section.
{%- endcomment -%}
<style>
  .kj-product-card-link {
    text-decoration: none;
    display: block;
  }

  .kj-product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.1;
    background-color: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .kj-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .kj-product-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-img-secondary {
    opacity: 0;
  }

  .kj-product-card:hover .kj-img-secondary {
    opacity: 1;
  }

  .kj-product-card:hover .kj-img-primary {
    opacity: 0;
  }

  .kj-shades-inline {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    font-size: 11px;
    color: #333;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-swatch-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 8px 0;
    min-height: 16px;
  }

  .kj-swatch {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #e2d5d5;
  }

  .kj-swatch-more {
    font-size: 10px;
    color: #666;
  }

  .kj-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin-top: 4px;
    line-height: 1;
  }

  .kj-star {
    font-size: 11px;
    color: #d8c8c8;
  }

  .kj-star--filled {
    color: #000;
  }

  .kj-stars--placeholder .kj-star--filled {
    color: #333;
  }

  .kj-star-count {
    font-size: 10px;
    color: #666;
    margin-left: 4px;
  }

  .kj-vto-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #000;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 8px;
    z-index: 2;
  }

  .kj-quick-add-wrap {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    padding: 10px;
    transition: bottom 0.3s ease;
    z-index: 2;
  }

  .kj-product-card:hover .kj-quick-add-wrap {
    bottom: 0;
  }

  .kj-quick-add-btn {
    font-family: var(--font-heading--family);
    width: 100%;
    background-color: #000;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
  }

  .kj-quick-add-btn:hover {
    background-color: #333;
  }

  .kj-product-info {
    text-align: left;
  }

  .kj-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .kj-product-title {
    font-family: var(--font-heading--family);
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 5px 0;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-product-price {
    font-size: 13px;
    margin-bottom: 5px;
    white-space: nowrap;
  }

  .kj-price-compare {
    color: #999;
    margin-right: 5px;
  }

  .kj-product-shades {
    font-size: 11px;
    color: #666;
    margin: 0;
    text-transform: lowercase;
  }

  @media screen and (max-width: 767px) {
    .kj-quick-add-wrap {
      display: none;
    }
  }
</style>
