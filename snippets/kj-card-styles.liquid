{%- comment -%}
  Shared visual styles for kj-product-card (Kylie reference anatomy).
  Rendered once per section that uses the card. Container-specific sizing
  (.kj-product-card flex/width) stays in the section.
{%- endcomment -%}
<style>
  .kj-product-card {
    background: #ffffff;
    border: 1px solid #ece4e4;
    border-radius: 8px;
    overflow: hidden;
  }

  .kj-product-card-link {
    text-decoration: none;
    display: block;
  }

  .kj-product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f0eded;
    overflow: hidden;
  }

  .kj-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .kj-product-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-img-secondary {
    opacity: 0;
  }

  .kj-product-card:hover .kj-img-secondary {
    opacity: 1;
  }

  .kj-product-card:hover .kj-img-primary {
    opacity: 0;
  }

  .kj-shades-inline {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-size: 12px;
    font-weight: 500;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e7e2e2;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-swatch-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 8px 0;
    min-height: 20px;
  }

  .kj-swatch {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid #e2d5d5;
  }

  .kj-swatch img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.8);
  }

  .kj-swatch-more {
    font-size: 10px;
    color: #666;
  }

  /* Bottom add-to-cart like the reference: revealed on hover, always visible on touch */
  .kj-card-add-form {
    padding: 0 14px 14px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .kj-product-card:hover .kj-card-add-form,
  .kj-card-add-form:focus-within {
    opacity: 1;
  }

  .kj-card-add {
    font-family: var(--font-heading--family);
    width: 100%;
    background: #3a3a3a;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 11px 16px;
    font-size: 13px;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .kj-card-add:hover:not(:disabled) { background: #191919; }
  .kj-card-add:disabled { background: #999; cursor: not-allowed; }

  .kj-product-info {
    text-align: left;
    padding: 12px 14px 16px;
    background: #ffffff;
  }

  .kj-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin: 0 0 5px;
    line-height: 1;
  }

  .kj-star {
    font-size: 12px;
    color: #d8c8c8;
  }

  .kj-star--filled {
    color: #000;
  }

  .kj-stars--placeholder .kj-star--filled {
    color: #333;
  }

  .kj-star-count {
    font-size: 11px;
    color: #666;
    margin-left: 4px;
  }

  .kj-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .kj-product-title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-product-price {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .kj-price-compare {
    color: #999;
    margin-right: 5px;
    font-weight: 400;
  }

  .kj-product-subtitle {
    font-size: 13px;
    color: #555;
    text-transform: lowercase;
    margin: 3px 0 0;
  }

  @media screen and (max-width: 767px) {
    .kj-card-add-form {
      opacity: 1;
    }
  }
</style>
