{%- comment -%}
  Shared visual styles for kj-product-card (Kylie reference anatomy).
  Rendered once per section that uses the card. Container-specific sizing
  (.kj-product-card flex/width) stays in the section.
{%- endcomment -%}
<style>
  .kj-product-card {
    background: #ffffff;
    border: 1px solid #ece4e4;
    border-radius: 8px;
    overflow: hidden;
  }

  .kj-product-card-link {
    text-decoration: none;
    display: block;
  }

  .kj-product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f0eded;
    overflow: hidden;
  }

  .kj-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .kj-product-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-img-secondary {
    opacity: 0;
  }

  .kj-product-card:hover .kj-img-secondary {
    opacity: 1;
  }

  .kj-product-card:hover .kj-img-primary {
    opacity: 0;
  }

  .kj-shades-inline {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-size: 12px;
    font-weight: 500;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e7e2e2;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-quick-add-wrap {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    padding: 10px;
    transition: bottom 0.3s ease;
    z-index: 2;
  }

  .kj-product-card:hover .kj-quick-add-wrap {
    bottom: 0;
  }

  .kj-quick-add-btn {
    font-family: var(--font-heading--family);
    width: 100%;
    background-color: #000;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
  }

  .kj-quick-add-btn:hover {
    background-color: #333;
  }

  .kj-product-info {
    text-align: left;
    padding: 12px 14px 16px;
    background: #ffffff;
  }

  .kj-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin: 0 0 5px;
    line-height: 1;
  }

  .kj-star {
    font-size: 12px;
    color: #d8c8c8;
  }

  .kj-star--filled {
    color: #000;
  }

  .kj-stars--placeholder .kj-star--filled {
    color: #333;
  }

  .kj-star-count {
    font-size: 11px;
    color: #666;
    margin-left: 4px;
  }

  .kj-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .kj-product-title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-product-price {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .kj-price-compare {
    color: #999;
    margin-right: 5px;
    font-weight: 400;
  }

  .kj-product-subtitle {
    font-size: 13px;
    color: #555;
    text-transform: lowercase;
    margin: 3px 0 0;
  }

  @media screen and (max-width: 767px) {
    .kj-quick-add-wrap {
      display: none;
    }
  }
</style>
