{%- comment -%}
  Shared visual styles for kj-product-card (Kylie reference anatomy).
  Rendered once per section that uses the card. Container-specific sizing
  (.kj-product-card flex/width) stays in the section.
{%- endcomment -%}
<style>
  .kj-product-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #DDD2C8;
    border-radius: 8px;
  }

  .kj-product-card:hover {
    z-index: 20;
  }

  .kj-product-image-wrap {
    border-radius: 7px 7px 0 0;
  }

  .kj-product-info {
    border-radius: 0 0 7px 7px;
  }

  .kj-product-card-link {
    text-decoration: none;
    display: block;
  }

  .kj-product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f0eded;
    overflow: hidden;
  }

  .kj-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .kj-product-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-img-secondary {
    opacity: 0;
  }

  .kj-product-card:hover .kj-img-secondary {
    opacity: 1;
  }

  .kj-product-card:hover .kj-img-primary {
    opacity: 0;
  }

  .kj-shades-inline {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-size: 12px;
    font-weight: 500;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-card-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: #ffffff;
    border: 1px solid #e7e2e2;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #222;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-swatch-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 8px 0;
    min-height: 20px;
  }

  .kj-swatch {
    display: block;
    width: 20px;
    height: 20px;
    padding: 0;
    background: none;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid #DDD2C8;
    cursor: pointer;
  }

  .kj-swatch--active {
    border: 2px solid #222222;
  }

  .kj-swatch img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(2.4); /* zoom toward product color; scale(5) hit blank white on product-on-white shots */
  }

  .kj-swatch-row {
    margin-bottom: 8px;
  }

  .kj-swatch-more {
    font-size: 10px;
    color: #666;
  }

  /* Reference hover: card bounds NEVER change; the panel anchors to the card
     bottom and its content grows UPWARD, overlapping the image. */
  .kj-card-hover-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-radius: 0 0 8px 8px;
    padding: 12px 14px 14px;
    box-shadow: 0 -10px 18px rgba(0, 0, 0, 0.05);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 15;
  }

  .kj-product-card:hover .kj-card-hover-panel,
  .kj-card-hover-panel:focus-within {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .kj-card-panel-link {
    display: block;
    text-decoration: none;
    color: inherit;
    margin-bottom: 12px;
  }

  .kj-card-add-form {
    margin: 0;
  }

  .kj-card-add {
    font-family: var(--font-heading--family);
    width: 100%;
    background: #222222; /* palette charcoal */
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 11px 16px;
    font-size: 13px;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .kj-card-add:hover:not(:disabled) { background: #000000; }
  .kj-card-add:disabled { background: #999; cursor: not-allowed; }

  .kj-product-info {
    text-align: left;
    padding: 12px 14px 16px;
    background: #ffffff;
  }

  .kj-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin: 0 0 5px;
    line-height: 1;
  }

  .kj-star {
    font-size: 12px;
    color: #DDD2C8;
  }

  .kj-star--filled {
    color: #000;
  }

  .kj-stars--placeholder .kj-star--filled {
    color: #333;
  }

  .kj-star-count {
    font-size: 11px;
    color: #666;
    margin-left: 4px;
  }

  .kj-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .kj-product-title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-product-price {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .kj-price-compare {
    color: #999;
    margin-right: 5px;
    font-weight: 400;
  }

  .kj-product-subtitle {
    font-size: 13px;
    color: #555;
    text-transform: lowercase;
    margin: 3px 0 0;
  }

  @media screen and (max-width: 767px) {
    /* No hover on touch: hide the duplicate at-rest info, show the full panel in flow */
    .kj-product-card .kj-product-info {
      display: none;
    }
    .kj-card-hover-panel {
      position: static;
      margin-top: 0;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      border: none;
      box-shadow: none;
      border-radius: 0 0 8px 8px;
    }
    .kj-product-card:hover {
      border-radius: 8px;
    }
  }
</style>

<script>
  (function () {
    /* AJAX add-to-cart for kj forms: add via /cart/add with a rendered
       cart-drawer section, swap it in, and open the drawer — instead of
       the native POST that hard-redirects to the cart page. */
    if (!window.__kjAjaxCart) {
      window.__kjAjaxCart = true;
      document.addEventListener('submit', function (e) {
        var form = e.target.closest('form.kj-card-add-form, form#kj-product-form');
        if (!form) return;
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var label = btn ? btn.innerHTML : '';
        if (btn) { btn.disabled = true; btn.innerHTML = 'adding…'; }
        var fd = new FormData(form);
        fd.append('sections', 'cart-drawer-section');
        var swapAndOpen = function (html) {
          var holder = document.getElementById('shopify-section-cart-drawer-section');
          if (html && holder) holder.outerHTML = html;
          var drawer = document.querySelector('#shopify-section-cart-drawer-section theme-drawer') ||
                       document.querySelector('cart-drawer-component theme-drawer');
          if (drawer && typeof drawer.open === 'function') {
            drawer.open();
          } else if (drawer) {
            drawer.setAttribute('open', '');
          }
        };
        /* sections also in the URL: analytics fetch-wrappers can re-serialize
           the body and drop appended fields (seen as sections:null) */
        fetch('/cart/add?sections=cart-drawer-section', {
          method: 'POST',
          body: fd,
          headers: { 'Accept': 'application/javascript', 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.status) throw new Error(data.description || 'add failed');
            if (data.sections && data.sections['cart-drawer-section']) {
              swapAndOpen(data.sections['cart-drawer-section']);
            } else {
              /* add succeeded but sections were stripped — refetch the drawer */
              fetch('/?sections=cart-drawer-section')
                .then(function (r) { return r.json(); })
                .then(function (s) { swapAndOpen(s['cart-drawer-section']); })
                .catch(function () { swapAndOpen(null); });
            }
          })
          .catch(function () {
            /* fall back to the native flow so the add still happens */
            form.removeAttribute('data-kj-ajax');
            form.submit();
          })
          .finally(function () {
            if (btn) { btn.disabled = false; btn.innerHTML = label; }
          });
      });
    }

    /* Card shade dots: click swaps the card image to that variant (delegated). */
    if (window.__kjCardDots) return;
    window.__kjCardDots = true;
    document.addEventListener('click', function (e) {
      var dot = e.target.closest('[data-kj-dot]');
      if (!dot) return;
      var card = dot.closest('.kj-product-card');
      if (!card || !dot.dataset.image) return;
      card.querySelectorAll('.kj-swatch--active').forEach(function (d) {
        d.classList.remove('kj-swatch--active');
      });
      dot.classList.add('kj-swatch--active');
      var primary = card.querySelector('.kj-img-primary');
      var secondary = card.querySelector('.kj-img-secondary');
      if (primary) primary.src = dot.dataset.image;
      if (secondary) secondary.src = dot.dataset.image;
    });
  })();
</script>
