{%- comment -%}
  "REAL RESULTS. REAL PEOPLE." — UGC card carousel: photo, stars,
  @handle, caption. Image settings accept a full URL or a theme asset
  filename.
{%- endcomment -%}

<div class="kj-ugc" id="kj-ugc-{{ section.id }}">
  <div class="kj-ugc-container">
    <div class="kj-ugc-header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="kj-ugc-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="kj-ugc-sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      <div class="kj-ugc-arrows">
        <button type="button" class="kj-ugc-arrow" data-kj-ugc-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="kj-ugc-arrow" data-kj-ugc-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="kj-ugc-trackwrap" data-kj-ugc-track data-kj-ugc-infinite data-count="{{ section.blocks.size }}">
      <div class="kj-ugc-track">
        {%- comment -%} set rendered three times: wrap keeps scroll inside the first
            set with two full sets of runway, so the scroller never clamps {%- endcomment -%}
        {%- for setpass in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign src = block.settings.image | strip
              if src != blank and src contains '//'
              elsif src != blank
                assign src = src | asset_url
              endif
            -%}
            <div class="kj-ugc-card" {% if setpass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true" data-kj-ugc-clone{% endif %}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="kj-ugc-cardlink"{% if setpass == 2 %} tabindex="-1"{% endif %}>{%- endif -%}
                {%- if src != blank -%}
                  <img src="{{ src }}" alt="{{ block.settings.handle | escape }}" loading="lazy" class="kj-ugc-img">
                {%- endif -%}
                <div class="kj-ugc-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                {%- if block.settings.handle != blank -%}
                  <p class="kj-ugc-handle">{{ block.settings.handle }}</p>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="kj-ugc-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  .kj-ugc {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
  }

  .kj-ugc-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-ugc-header {
    position: relative;
    text-align: center;
    margin-bottom: 26px;
  }

  .kj-ugc-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#222222' }};
    margin: 0 0 6px;
  }

  .kj-ugc-sub {
    font-size: 13px;
    color: #777;
    margin: 0;
  }

  .kj-ugc-arrows {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 8px;
  }

  .kj-ugc-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #DDD2C8;
    background: #fff;
    color: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .kj-ugc-arrow:hover { border-color: #222; }

  .kj-ugc-trackwrap {
    margin: 0 -20px;
    padding: 0 20px;
    border-radius: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .kj-ugc-trackwrap::-webkit-scrollbar { display: none; }

  .kj-ugc-track {
    display: flex;
    gap: 18px;
  }

  .kj-ugc-card {
    flex: 0 0 19%;
    min-width: 218px;
  }

  .kj-ugc-cardlink { display: block; text-decoration: none; color: inherit; }

  .kj-ugc-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  .kj-ugc-stars {
    color: #222;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 5px;
  }

  .kj-ugc-handle {
    font-size: 12px;
    font-weight: 700;
    color: #222;
    margin: 0 0 3px;
  }

  .kj-ugc-caption {
    font-size: 12px;
    line-height: 1.5;
    color: #666;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .kj-ugc-card { flex: 0 0 62%; min-width: 0; }
  }
</style>

<script>
  (function () {
    /* infinite loop: the card set is rendered twice; when scroll passes one
       set-width it wraps back silently. A slow marquee keeps it drifting,
       pausing on hover/touch and after arrow clicks. Morph-safe: state in
       data attributes, one global rAF drives every carousel on the page. */
    if (window.__kjUgcDelegated) return;
    window.__kjUgcDelegated = true;

    function period(wrap) {
      var n = parseInt(wrap.dataset.count, 10) || 0;
      var kids = wrap.querySelectorAll('.kj-ugc-card');
      if (!n || kids.length < n + 1) return 0;
      return kids[n].offsetLeft - kids[0].offsetLeft;
    }

    function normalize(wrap) {
      var W = period(wrap);
      if (!W) return W;
      if (wrap.scrollLeft >= W) wrap.scrollLeft -= W;
      return W;
    }

    document.addEventListener('click', function (e) {
      var prev = e.target.closest('[data-kj-ugc-prev]');
      var next = e.target.closest('[data-kj-ugc-next]');
      if (!prev && !next) return;
      var root = e.target.closest('.kj-ugc');
      var wrap = root && root.querySelector('[data-kj-ugc-track]');
      if (!wrap) return;
      var card = wrap.querySelector('.kj-ugc-card');
      var step = card ? card.getBoundingClientRect().width + 18 : 260;
      wrap.dataset.hold = Date.now() + 4000;
      var W = period(wrap);
      if (prev && W && wrap.scrollLeft < step) wrap.scrollLeft += W;
      wrap.scrollBy({ left: prev ? -step : step, behavior: 'smooth' });
    });

    ['pointerdown', 'touchstart'].forEach(function (evt) {
      document.addEventListener(evt, function (e) {
        var wrap = e.target.closest && e.target.closest('[data-kj-ugc-infinite]');
        if (wrap) wrap.dataset.hold = Date.now() + 4000;
      }, { passive: true });
    });

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function tick() {
      document.querySelectorAll('[data-kj-ugc-infinite]').forEach(function (wrap) {
        var W = normalize(wrap);
        if (!W || reduced) return;
        var hold = parseInt(wrap.dataset.hold, 10) || 0;
        if (Date.now() < hold) return;
        if (wrap.matches(':hover')) return;
        wrap.scrollLeft += 0.5;
      });
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>

{% schema %}
{
  "name": "KJ UGC Carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "REAL RESULTS. REAL PEOPLE." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Discover how our community wears ST London." },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#222222" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "ugc",
      "name": "UGC card",
      "settings": [
        { "type": "text", "id": "image", "label": "Image (URL or asset filename)" },
        { "type": "text", "id": "handle", "label": "@handle" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "KJ UGC Carousel" }
  ]
}
{% endschema %}
