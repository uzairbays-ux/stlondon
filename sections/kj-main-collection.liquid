{% render 'kj-card-styles' %}

<div class="kj-collection-page" style="background-color: {{ section.settings.bg_color }};">

  <div class="kj-collection-header">
    <h1 class="kj-collection-title" style="color: {{ section.settings.heading_color }};">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="kj-collection-description">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {% paginate collection.products by section.settings.products_per_page %}

    <div class="kj-collection-container">

      <div class="kj-collection-toolbar">
        <span class="kj-collection-count">{{ collection.products_count }} products</span>
        <form class="kj-collection-sort" method="get">
          {%- if collection.current_type or collection.current_vendor -%}
            <input type="hidden" name="q" value="{{ collection.current_type | default: collection.current_vendor | escape }}">
          {%- endif -%}
          <label for="kj-sort-{{ section.id }}">sort by:</label>
          <select id="kj-sort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | downcase }}</option>
            {%- endfor -%}
          </select>
        </form>
      </div>

      {%- if collection.products.size == 0 -%}
        <p class="kj-no-products">no products found in this collection.</p>
      {%- else -%}
        <div class="kj-collection-grid">
          {%- for product in collection.products -%}
            {% render 'kj-product-card', product: product, show_secondary_image: true, text_color: section.settings.text_color %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="kj-pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="kj-page-arrow">&larr; prev</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="kj-page-num">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="kj-page-num kj-page-current">{{ part.title }}</span>
              {%- else -%}
                <span class="kj-page-num">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="kj-page-arrow">next &rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}

    </div>

  {% endpaginate %}
</div>

<style>
  .kj-collection-page {
    width: 100%;
    padding-bottom: 80px;
  }

  .kj-collection-header {
    text-align: center;
    padding: 46px 20px 24px;
  }

  .kj-collection-title {
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 1px;
    margin: 0 0 12px 0;
  }

  .kj-collection-description {
    max-width: 560px;
    margin: 0 auto;
    font-size: 13px;
    line-height: 1.6;
    color: #555;
  }

  .kj-collection-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #e8dede;
    border-bottom: 1px solid #e8dede;
    padding: 12px 0;
    margin-bottom: 28px;
  }

  .kj-collection-count {
    font-size: 12px;
    color: #666;
    text-transform: lowercase;
    letter-spacing: 0.3px;
  }

  .kj-collection-sort {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    text-transform: lowercase;
  }

  .kj-collection-sort select {
    border: none;
    background: transparent;
    font-size: 12px;
    font-weight: 600;
    text-transform: lowercase;
    cursor: pointer;
    padding: 4px 2px;
    outline: none;
  }

  .kj-collection-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px 20px;
  }

  .kj-no-products {
    text-align: center;
    font-size: 14px;
    color: #666;
    padding: 60px 0;
  }

  .kj-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 50px;
  }

  .kj-page-num,
  .kj-page-arrow {
    font-size: 13px;
    color: #333;
    text-decoration: none;
    text-transform: lowercase;
    padding: 6px 10px;
  }

  .kj-page-current {
    background: #000;
    color: #fff;
    border-radius: 100px;
  }

  a.kj-page-num:hover,
  a.kj-page-arrow:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .kj-collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .kj-collection-grid {
      gap: 20px 12px;
    }
    .kj-collection-title {
      font-size: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Main Collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "label": "Products Per Page",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#b0697a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7efef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
