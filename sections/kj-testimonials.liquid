{%- comment -%}
  "LOVED BY BEAUTY LOVERS" — quote card carousel with arrows.
{%- endcomment -%}

<div class="kj-tstm" id="kj-tstm-{{ section.id }}">
  <div class="kj-tstm-container">
    <div class="kj-tstm-head">
      {%- if section.settings.heading != blank -%}
        <h2 class="kj-tstm-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_line != blank -%}
        <p class="kj-tstm-rating"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_line }}</p>
      {%- endif -%}
    </div>

    <div class="kj-tstm-row">
      <button type="button" class="kj-tstm-arrow" data-kj-tstm-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="kj-tstm-trackwrap" data-kj-tstm-track data-kj-tstm-infinite data-count="{{ section.blocks.size }}">
        <div class="kj-tstm-track">
          {%- comment -%} set rendered three times: wrap keeps scroll inside the
              first set with two full sets of runway, so it never clamps {%- endcomment -%}
          {%- for setpass in (1..3) -%}
            {%- for block in section.blocks -%}
              <div class="kj-tstm-card" {% if setpass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true" data-kj-tstm-clone{% endif %}>
                <span class="kj-tstm-mark" aria-hidden="true">&ldquo;</span>
                <div class="kj-tstm-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                <p class="kj-tstm-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                {%- if block.settings.author != blank -%}
                  <p class="kj-tstm-author">&mdash; {{ block.settings.author }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
      <button type="button" class="kj-tstm-arrow" data-kj-tstm-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .kj-tstm {
    background: linear-gradient(180deg, {{ section.settings.bg_color | default: '#F8F5F2' }} 0%, #F2ECE5 100%);
    padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 48 }}px;
  }

  .kj-tstm-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-tstm-head {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 22px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .kj-tstm-heading {
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#222222' }};
    margin: 0;
  }

  .kj-tstm-rating {
    font-size: 12.5px;
    color: #6F5545;
    margin: 0;
  }

  .kj-tstm-rating span { color: #C6A46C; letter-spacing: 3px; }

  .kj-tstm-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .kj-tstm-arrow {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #DDD2C8;
    background: #fff;
    color: #6F5545;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(111, 85, 69, 0.10);
    transition: all 0.2s ease;
  }

  .kj-tstm-arrow:hover { border-color: #C6A46C; color: #C6A46C; }

  .kj-tstm-trackwrap {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 12px 4px 26px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .kj-tstm-trackwrap::-webkit-scrollbar { display: none; }

  .kj-tstm-track {
    display: flex;
    gap: 16px;
  }

  .kj-tstm-card {
    position: relative;
    flex: 0 0 24%;
    min-width: 260px;
    background: #ffffff;
    border-radius: 14px;
    padding: 30px 24px 22px;
    box-shadow: 0 14px 34px rgba(111, 85, 69, 0.12);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .kj-tstm-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(111, 85, 69, 0.18);
  }

  .kj-tstm-mark {
    position: absolute;
    top: -14px;
    right: 10px;
    font-family: var(--font-heading--family);
    font-size: 110px;
    line-height: 1;
    color: #C6A46C;
    opacity: 0.18;
    pointer-events: none;
  }

  .kj-tstm-stars {
    color: #C6A46C;
    font-size: 12px;
    letter-spacing: 3px;
    margin-bottom: 12px;
  }

  .kj-tstm-quote {
    font-family: var(--font-heading--family);
    font-size: 15px;
    line-height: 1.65;
    color: #222;
    margin: 0 0 16px;
  }

  .kj-tstm-author {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #91715B;
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid #F0E9E1;
  }

  @media screen and (max-width: 749px) {
    .kj-tstm-card { flex: 0 0 78%; min-width: 0; }
    .kj-tstm-arrow { display: none; }
  }
</style>

<script>
  (function () {
    /* infinite loop, same scheme as the UGC carousel: tripled set, scroll
       normalized into the first set, slow marquee paused on hover/touch. */
    if (window.__kjTstmDelegated) return;
    window.__kjTstmDelegated = true;

    function period(wrap) {
      var n = parseInt(wrap.dataset.count, 10) || 0;
      var kids = wrap.querySelectorAll('.kj-tstm-card');
      if (!n || kids.length < n + 1) return 0;
      return kids[n].offsetLeft - kids[0].offsetLeft;
    }

    function normalize(wrap) {
      var W = period(wrap);
      if (!W) return W;
      if (wrap.scrollLeft >= W) wrap.scrollLeft -= W;
      return W;
    }

    document.addEventListener('click', function (e) {
      var prev = e.target.closest('[data-kj-tstm-prev]');
      var next = e.target.closest('[data-kj-tstm-next]');
      if (!prev && !next) return;
      var root = e.target.closest('.kj-tstm');
      var wrap = root && root.querySelector('[data-kj-tstm-track]');
      if (!wrap) return;
      var card = wrap.querySelector('.kj-tstm-card');
      var step = card ? card.getBoundingClientRect().width + 16 : 280;
      wrap.dataset.hold = Date.now() + 4000;
      var W = period(wrap);
      if (prev && W && wrap.scrollLeft < step) wrap.scrollLeft += W;
      wrap.scrollBy({ left: prev ? -step : step, behavior: 'smooth' });
    });

    ['pointerdown', 'touchstart'].forEach(function (evt) {
      document.addEventListener(evt, function (e) {
        var wrap = e.target.closest && e.target.closest('[data-kj-tstm-infinite]');
        if (wrap) wrap.dataset.hold = Date.now() + 4000;
      }, { passive: true });
    });

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function tick() {
      document.querySelectorAll('[data-kj-tstm-infinite]').forEach(function (wrap) {
        var W = normalize(wrap);
        if (!W || reduced) return;
        var hold = parseInt(wrap.dataset.hold, 10) || 0;
        if (Date.now() < hold) return;
        if (wrap.matches(':hover')) return;
        wrap.scrollLeft += 0.4;
      });
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>

{% schema %}
{
  "name": "KJ Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LOVED BY BEAUTY LOVERS" },
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "4.8/5 based on 10,000+ reviews" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#222222" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F8F5F2" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 56 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "KJ Testimonials" }
  ]
}
{% endschema %}
