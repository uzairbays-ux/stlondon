<div class="kj-ig-grid" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="kj-ig-container">

    <div class="kj-ig-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="kj-ig-heading" style="color: {{ section.settings.heading_color | default: section.settings.text_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle_text != blank -%}
        <a href="{{ section.settings.handle_link | default: '#' }}" class="kj-ig-handle" style="color: {{ section.settings.text_color }};" target="_blank" rel="noopener">{{ section.settings.handle_text }}</a>
      {%- endif -%}
    </div>

    <div class="kj-ig-tiles">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="kj-ig-tile"
          {% if block.settings.link contains 'instagram.com' %}target="_blank" rel="noopener"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" class="kj-ig-img" loading="lazy" width="600" height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'kj-ig-placeholder' }}
          {%- endif -%}
          <span class="kj-ig-tile-overlay">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </span>
        </a>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..6) -%}
          <div class="kj-ig-tile">
            {{ 'image' | placeholder_svg_tag: 'kj-ig-placeholder' }}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  .kj-ig-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-ig-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .kj-ig-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 8px 0;
  }

  .kj-ig-handle {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-decoration: underline;
  }

  .kj-ig-tiles {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .kj-ig-tiles::-webkit-scrollbar {
    display: none;
  }

  .kj-ig-tile {
    position: relative;
    flex: 0 0 auto;
    width: calc((100% - 40px) / 5);
    min-width: 200px;
    aspect-ratio: 1/1;
    overflow: hidden;
    background-color: #f4f4f4;
    display: block;
    scroll-snap-align: start;
  }

  .kj-ig-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .kj-ig-tile:hover .kj-ig-img {
    transform: scale(1.05);
  }

  .kj-ig-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-ig-tile-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .kj-ig-tile:hover .kj-ig-tile-overlay {
    opacity: 1;
  }

  @media screen and (max-width: 599px) {
    .kj-ig-tile {
      width: 65%;
      min-width: 0;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Instagram Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP OUR IG"
    },
    {
      "type": "text",
      "id": "handle_text",
      "label": "Handle Text",
      "default": "@stlondon"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Handle Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#b0697a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (product or Instagram post)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "KJ Instagram Grid",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
