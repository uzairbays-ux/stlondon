<script>
  (function () {
    /* Homepage try-on studio — delegated document-level (survives DOM morph).
       One applied product per category slot, all rendered together:
       lips = lip fill, face = cheek blush, eyes = lid shadow.
       Engine = MediaPipe Tasks API FaceLandmarker, synchronous
       detectForVideo per frame in our own rAF loop. */
    if (window.__kjHomeVto) return;
    window.__kjHomeVto = { stream: null, raf: null, face: null, applied: {}, loading: false, agreed: false, compare: false, split: 0.5, drag: false };
    var S = window.__kjHomeVto;
    var MP_VER = 'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.21';

    function els() {
      var overlay = document.querySelector('[data-kj-hvto-overlay]');
      if (!overlay) return null;
      return {
        overlay: overlay,
        consent: document.querySelector('[data-kj-hvto-consent]'),
        ready: overlay.querySelector('[data-kj-hvto-ready]'),
        readyLabel: overlay.querySelector('[data-kj-hvto-ready-label]'),
        live: overlay.querySelector('[data-kj-hvto-live]'),
        video: overlay.querySelector('[data-kj-hvto-video]'),
        canvas: overlay.querySelector('[data-kj-hvto-canvas]'),
        divider: overlay.querySelector('[data-kj-hvto-divider]'),
        flash: overlay.querySelector('[data-kj-hvto-flash]'),
        cam: overlay.querySelector('.kj-hvto-cam'),
        cats: overlay.querySelector('[data-kj-hvto-cats]'),
        list: overlay.querySelector('[data-kj-hvto-list]'),
        detail: overlay.querySelector('[data-kj-hvto-detail]'),
        tray: overlay.querySelector('[data-kj-hvto-tray]'),
        trayChips: overlay.querySelector('[data-kj-hvto-tray-chips]')
      };
    }

    function esc(x) {
      return String(x == null ? '' : x).replace(/[&<>"]/g, function (ch) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch];
      });
    }

    function railState(name) {
      var e = els();
      if (!e) return;
      e.cats.hidden = name !== 'cats';
      e.list.hidden = name !== 'list';
      e.detail.hidden = name !== 'detail';
    }

    function showCat(ci) {
      var e = els();
      if (!e) return;
      railState('list');
      e.list.querySelectorAll('[data-kj-hvto-tab]').forEach(function (t) {
        t.classList.toggle('active', t.dataset.kjHvtoTab === ci);
      });
      e.list.querySelectorAll('[data-kj-hvto-grid]').forEach(function (g) {
        g.hidden = g.dataset.kjHvtoGrid !== ci;
      });
    }

    function applyFromDot(pd, dot) {
      if (!pd || !dot) return;
      var mode = pd.dataset.mode || 'lips';
      S.applied[mode] = {
        color: dot.dataset.color,
        name: dot.dataset.name || '',
        vid: dot.dataset.vid,
        avail: dot.dataset.avail !== 'false',
        title: pd.dataset.title || '',
        money: pd.dataset.money || '',
        cents: parseInt(pd.dataset.cents, 10) || 0,
        pdKey: pd.dataset.kjHvtoPd
      };
      renderTray();
    }

    function renderTray() {
      var e = els();
      if (!e || !e.tray) return;
      var modes = ['eyes', 'face', 'lips'];
      var chips = '';
      var total = 0, symbol = '£', count = 0;
      modes.forEach(function (m) {
        var s = S.applied[m];
        if (!s) return;
        count++;
        total += s.cents || 0;
        if (s.money) {
          var sym = s.money.replace(/[\d.,\s]/g, '');
          if (sym) symbol = sym;
        }
        chips += '<span class="kj-hvto-chip" data-kj-hvto-chip="' + m + '">' +
          '<i style="background:' + esc(s.color) + '"></i>' +
          '<em>' + esc(s.title) + (s.name ? ' &middot; ' + esc(s.name) : '') + '</em>' +
          '<button type="button" data-kj-hvto-unapply="' + m + '" aria-label="remove">&times;</button>' +
          '</span>';
      });
      e.trayChips.innerHTML = chips;
      e.tray.hidden = count === 0;
      var btn = e.tray.querySelector('[data-kj-hvto-addall]');
      if (btn && count > 0) {
        btn.textContent = 'add all to cart - ' + symbol + (total / 100).toFixed(2);
      }
    }

    function showProduct(key) {
      var e = els();
      if (!e) return;
      railState('detail');
      var shown = null;
      e.detail.querySelectorAll('[data-kj-hvto-pd]').forEach(function (p) {
        var match = p.dataset.kjHvtoPd === key;
        p.hidden = !match;
        if (match) shown = p;
      });
      if (!shown) return;
      var dot = shown.querySelector('.kj-hvto-dot.active') || shown.querySelector('.kj-hvto-dot');
      if (dot) applyFromDot(shown, dot);
    }

    function dist(a, b, w, h) {
      var dx = (a.x - b.x) * w;
      var dy = (a.y - b.y) * h;
      return Math.sqrt(dx * dx + dy * dy);
    }

    function softBlob(ctx, cx, cy, r, squash, color) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(1, squash);
      var g = ctx.createRadialGradient(0, 0, 0, 0, 0, r);
      g.addColorStop(0, color);
      g.addColorStop(1, color.slice(0, 7) + '00');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(0, 0, r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawFrame(e, faceRes) {
      if (!e.ready.hidden) { e.ready.hidden = true; e.live.hidden = false; }
      var canvas = e.canvas, ctx = canvas.getContext('2d');
      if (canvas.width !== e.video.videoWidth && e.video.videoWidth) {
        canvas.width = e.video.videoWidth;
        canvas.height = e.video.videoHeight;
      }
      var w = canvas.width, h = canvas.height;
      if (!w) return;
      ctx.save();
      ctx.clearRect(0, 0, w, h);
      ctx.drawImage(e.video, 0, 0, w, h);
      var slots = S.applied;
      if (slots.lips || slots.face || slots.eyes) {
        if (S.compare) {
          /* canvas is CSS-mirrored: right of the on-screen divider = left of the bitmap */
          ctx.beginPath();
          ctx.rect(0, 0, w * (1 - S.split), h);
          ctx.clip();
        }
        var lm = (faceRes && faceRes.faceLandmarks && faceRes.faceLandmarks[0]) || null;
        if (lm) {
          ctx.globalCompositeOperation = 'multiply';
          if (slots.lips) {
            var outer = [61, 146, 91, 181, 84, 17, 314, 405, 321, 375, 291, 409, 270, 269, 267, 0, 37, 39, 40, 185, 61];
            var inner = [78, 95, 88, 178, 87, 14, 317, 402, 318, 324, 308, 415, 310, 311, 312, 13, 82, 81, 80, 191, 78];
            ctx.fillStyle = slots.lips.color + '80';
            ctx.beginPath();
            outer.forEach(function (idx, i) {
              var pt = lm[idx];
              if (i === 0) ctx.moveTo(pt.x * w, pt.y * h);
              else ctx.lineTo(pt.x * w, pt.y * h);
            });
            inner.forEach(function (idx, i) {
              var pt = lm[idx];
              if (i === 0) ctx.moveTo(pt.x * w, pt.y * h);
              else ctx.lineTo(pt.x * w, pt.y * h);
            });
            ctx.fill('evenodd');
          }
          if (slots.face) {
            var faceW = dist(lm[234], lm[454], w, h);
            softBlob(ctx, lm[205].x * w, lm[205].y * h, faceW * 0.14, 0.8, slots.face.color + '4D');
            softBlob(ctx, lm[425].x * w, lm[425].y * h, faceW * 0.14, 0.8, slots.face.color + '4D');
          }
          if (slots.eyes) {
            var reW = dist(lm[33], lm[133], w, h);
            var reH = dist(lm[159], lm[145], w, h);
            var leW = dist(lm[362], lm[263], w, h);
            var leH = dist(lm[386], lm[374], w, h);
            if (lm[468]) softBlob(ctx, lm[468].x * w, lm[468].y * h - reH * 1.7, reW * 0.62, 0.55, slots.eyes.color + '59');
            if (lm[473]) softBlob(ctx, lm[473].x * w, lm[473].y * h - leH * 1.7, leW * 0.62, 0.55, slots.eyes.color + '59');
          }
          ctx.globalCompositeOperation = 'source-over';
        }
      }
      ctx.restore();
    }

    function cameraFail() {
      var e = els();
      if (e && e.readyLabel) e.readyLabel.textContent = 'camera unavailable — please allow camera access';
    }

    function loadTasks() {
      if (S.face) return Promise.resolve();
      return import(MP_VER + '/vision_bundle.mjs').then(function (m) {
        return m.FilesetResolver.forVisionTasks(MP_VER + '/wasm').then(function (fs) {
          var mk = function (Ctor, path, opts) {
            var make = function (delegate) {
              var o = { baseOptions: { modelAssetPath: path, delegate: delegate }, runningMode: 'VIDEO' };
              for (var k in opts) o[k] = opts[k];
              return Ctor.createFromOptions(fs, o);
            };
            return make('GPU').catch(function () { return make('CPU'); });
          };
          return mk(m.FaceLandmarker, 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task', { numFaces: 1 })
            .then(function (r) { S.face = r; });
        });
      });
    }

    function startLoop() {
      if (S.raf) cancelAnimationFrame(S.raf);
      var tick = function () {
        var e = els();
        if (!e || e.overlay.hidden || !S.stream) { S.raf = null; return; }
        if (e.video.readyState >= 2 && S.face) {
          var faceRes = null;
          try { faceRes = S.face.detectForVideo(e.video, performance.now()); } catch (err) {}
          drawFrame(e, faceRes);
        }
        S.raf = requestAnimationFrame(tick);
      };
      S.raf = requestAnimationFrame(tick);
    }

    function startAR() {
      var e = els();
      if (!e || S.loading) return;
      S.loading = true;
      loadTasks()
        .then(function () {
          return navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
            audio: false
          });
        })
        .then(function (stream) {
          S.loading = false;
          S.stream = stream;
          e.video.srcObject = stream;
          var p = e.video.play();
          if (p && p.catch) p.catch(function () {});
          startLoop();
        })
        .catch(function () { S.loading = false; cameraFail(); });
    }

    function swapDrawerAndOpen(html) {
      var holder = document.getElementById('shopify-section-cart-drawer-section');
      if (html && holder) holder.outerHTML = html;
      var drawer = document.querySelector('#shopify-section-cart-drawer-section theme-drawer') ||
                   document.querySelector('cart-drawer-component theme-drawer');
      if (drawer && typeof drawer.open === 'function') drawer.open();
      else if (drawer) drawer.setAttribute('open', '');
    }

    function openStudio() {
      var e = els();
      if (!e) return;
      e.overlay.hidden = false;
      e.ready.hidden = false;
      e.live.hidden = true;
      if (e.readyLabel) e.readyLabel.textContent = 'getting ready';
      railState('cats');
      renderTray();
      startAR();
    }

    function closeAll() {
      var e = els();
      if (!e) return;
      if (e.consent) e.consent.hidden = true;
      e.overlay.hidden = true;
      S.compare = false;
      if (e.divider) e.divider.hidden = true;
      var cmp = e.overlay.querySelector('[data-kj-hvto-compare]');
      if (cmp) cmp.classList.remove('active');
      if (S.raf) { cancelAnimationFrame(S.raf); S.raf = null; }
      if (S.stream) {
        S.stream.getTracks().forEach(function (t) { t.stop(); });
        S.stream = null;
      }
      if (e.video) e.video.srcObject = null;
    }

    document.addEventListener('click', function (ev) {
      var open = ev.target.closest('[data-kj-hvto-open]');
      if (open) {
        var e = els();
        if (!e) return;
        if (S.agreed) { openStudio(); return; }
        if (e.consent) e.consent.hidden = false;
        return;
      }
      if (ev.target.closest('[data-kj-hvto-close]')) { closeAll(); return; }
      var agree = ev.target.closest('[data-kj-hvto-agree]');
      if (agree && !agree.disabled) {
        S.agreed = true;
        var e1 = els();
        if (e1 && e1.consent) e1.consent.hidden = true;
        openStudio();
        return;
      }
      var cat = ev.target.closest('[data-kj-hvto-cat]');
      if (cat) { showCat(cat.dataset.kjHvtoCat); return; }
      var tab = ev.target.closest('[data-kj-hvto-tab]');
      if (tab) { showCat(tab.dataset.kjHvtoTab); return; }
      var openPd = ev.target.closest('[data-kj-hvto-open-pd]');
      if (openPd) { showProduct(openPd.dataset.kjHvtoOpenPd); return; }
      var back = ev.target.closest('[data-kj-hvto-back]');
      if (back) { showCat(back.dataset.kjHvtoBack); return; }
      var dot = ev.target.closest('[data-kj-hvto-dot]');
      if (dot) {
        var pd = dot.closest('[data-kj-hvto-pd]');
        pd.querySelectorAll('[data-kj-hvto-dot]').forEach(function (d) { d.classList.remove('active'); });
        dot.classList.add('active');
        var label = pd.querySelector('[data-kj-hvto-shadelabel]');
        if (label) label.textContent = dot.dataset.name || '';
        var vid = pd.querySelector('[data-kj-hvto-varid]');
        if (vid && dot.dataset.vid) vid.value = dot.dataset.vid;
        applyFromDot(pd, dot);
        return;
      }
      var unapply = ev.target.closest('[data-kj-hvto-unapply]');
      if (unapply) {
        delete S.applied[unapply.dataset.kjHvtoUnapply];
        renderTray();
        return;
      }
      var chip = ev.target.closest('[data-kj-hvto-chip]');
      if (chip) {
        var slot = S.applied[chip.dataset.kjHvtoChip];
        if (slot && slot.pdKey) showProduct(slot.pdKey);
        return;
      }
      var addAll = ev.target.closest('[data-kj-hvto-addall]');
      if (addAll) {
        var items = [];
        Object.keys(S.applied).forEach(function (m) {
          var s = S.applied[m];
          if (s && s.vid && s.avail !== false) items.push(parseInt(s.vid, 10));
        });
        if (!items.length) return;
        var origLabel = addAll.textContent;
        addAll.disabled = true;
        addAll.textContent = 'adding…';
        /* sequential single adds: a sold-out item must not sink the rest
           (a multi-item /cart/add.js stops at the first failure) */
        var queue = Promise.resolve();
        items.forEach(function (id) {
          queue = queue.then(function () {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ id: id, quantity: 1 })
            }).catch(function () {});
          });
        });
        queue
          .then(function () {
            return fetch('/?sections=cart-drawer-section')
              .then(function (r) { return r.json(); })
              .then(function (s) { swapDrawerAndOpen(s['cart-drawer-section']); })
              .catch(function () { swapDrawerAndOpen(null); });
          })
          .finally(function () {
            addAll.disabled = false;
            addAll.textContent = origLabel;
            renderTray();
          });
        return;
      }
      var snap = ev.target.closest('[data-kj-hvto-snap]');
      if (snap) {
        var e2 = els();
        if (!e2 || !e2.canvas.width) return;
        var a = document.createElement('a');
        a.download = 'st-london-try-on.png';
        a.href = e2.canvas.toDataURL('image/png');
        a.click();
        if (e2.flash) {
          e2.flash.classList.remove('on');
          void e2.flash.offsetWidth;
          e2.flash.classList.add('on');
        }
        return;
      }
      var cmp = ev.target.closest('[data-kj-hvto-compare]');
      if (cmp) {
        var e3 = els();
        if (!e3) return;
        S.compare = !S.compare;
        S.split = 0.5;
        e3.divider.hidden = !S.compare;
        e3.divider.style.left = '50%';
        cmp.classList.toggle('active', S.compare);
      }
    });

    document.addEventListener('change', function (ev) {
      var check = ev.target.closest('[data-kj-hvto-check]');
      if (!check) return;
      var agree = document.querySelector('[data-kj-hvto-agree]');
      if (agree) agree.disabled = !check.checked;
    });

    /* compare divider drag (relative to the camera panel) */
    document.addEventListener('pointerdown', function (ev) {
      if (!ev.target.closest('[data-kj-hvto-handle]')) return;
      ev.preventDefault();
      S.drag = true;
    });
    document.addEventListener('pointermove', function (ev) {
      if (!S.drag) return;
      var e = els();
      if (!e) return;
      var r = e.cam.getBoundingClientRect();
      S.split = Math.min(0.88, Math.max(0.12, (ev.clientX - r.left) / r.width));
      e.divider.style.left = (S.split * 100) + '%';
    });
    document.addEventListener('pointerup', function () { S.drag = false; });
  })();
</script>

