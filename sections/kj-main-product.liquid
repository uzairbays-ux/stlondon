{% render 'kj-card-styles' %}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%}
  Media is grouped per shade via media alt text (alt == variant title).
  If any media matches the current variant, the gallery filters to the
  selected shade's set (reference behavior); otherwise all media shows.
{%- endcomment -%}
{%- assign has_shade_media = false -%}
{%- for media in product.media -%}
  {%- if media.alt == current_variant.title -%}
    {%- assign has_shade_media = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="kj-pdp" id="kj-pdp-{{ section.id }}" data-has-shade-media="{{ has_shade_media }}">
  <div class="kj-pdp-container">

    <!-- Gallery group: thumbnail rail + main image as one unit -->
    <div class="kj-pdp-gallery-group">

    <div class="kj-pdp-thumbs" data-kj-thumbs>
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- assign hidden = false -%}
          {%- if has_shade_media and media.alt != current_variant.title -%}{%- assign hidden = true -%}{%- endif -%}
          <button
            type="button"
            class="kj-pdp-thumb{% if hidden %} kj-media-hidden{% endif %}"
            data-kj-pdp-thumb
            data-alt="{{ media.alt | escape }}"
            data-full="{{ media | image_url: width: 1400 }}"
            aria-label="View image"
          >
            <img src="{{ media | image_url: width: 160, height: 160, crop: 'center' }}" alt="{{ media.alt | escape }}" width="80" height="80" loading="lazy">
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Main image -->
    <div class="kj-pdp-main-media">
      {%- assign main_media = product.featured_image -%}
      {%- if has_shade_media -%}
        {%- for media in product.media -%}
          {%- if media.alt == current_variant.title -%}{%- assign main_media = media -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if main_media != blank -%}
        <img src="{{ main_media | image_url: width: 1400 }}" alt="{{ product.title | escape }}" class="kj-pdp-img" data-kj-pdp-main width="1400" height="{{ 1400 | divided_by: main_media.aspect_ratio | round }}">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'kj-pdp-placeholder' }}
      {%- endif -%}
    </div>

    {%- assign vto_swatch_count = 0 -%}
    {%- capture vto_swatches -%}
      {%- for variant in product.variants -%}
        {%- capture vv_hex -%}{% render 'kj-shade-hex', shade: variant.title %}{%- endcapture -%}
        {%- if vv_hex != blank -%}
          <button type="button" class="kj-pdpvto-swatch{% if vto_swatch_count == 0 %} active{% endif %}" data-kj-vto-color="{{ vv_hex }}" data-kj-vto-name="{{ variant.title | escape }}" style="background-color: {{ vv_hex }};" aria-label="{{ variant.title | escape }}"></button>
          {%- assign vto_swatch_count = vto_swatch_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if vto_swatch_count > 0 -%}
      <button type="button" class="kj-pdpvto-open" data-kj-vto-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        virtual try-on
      </button>

      <div class="kj-pdpvto-modal" data-kj-vto-modal>
        <div class="kj-pdpvto-content">
          <button type="button" class="kj-pdpvto-close" data-kj-vto-close aria-label="Close">&times;</button>
          <div class="kj-pdpvto-video-wrap">
            <video data-kj-vto-video class="kj-pdpvto-video" playsinline></video>
            <canvas data-kj-vto-canvas class="kj-pdpvto-canvas"></canvas>
            <div data-kj-vto-loading class="kj-pdpvto-loading">INITIALIZING CAMERA...</div>
          </div>
          <div class="kj-pdpvto-controls">
            <p>shade: <strong data-kj-vto-shadename>&nbsp;</strong></p>
            <div class="kj-pdpvto-swatches">
              {{ vto_swatches }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    </div>

    <!-- Info rail -->
    <div class="kj-pdp-info">

      <nav class="kj-pdp-breadcrumbs">
        <a href="{{ routes.root_url }}">home</a> / <span>{{ product.title | downcase }}</span>
      </nav>

      <div class="kj-pdp-title-row">
        <h1 class="kj-pdp-title">{{ product.title }}</h1>
        {%- assign pdp_badge = '' -%}
        {%- for tag in product.tags -%}
          {%- assign tag_down = tag | downcase -%}
          {%- if tag_down == 'best seller' or tag_down == 'bestseller' or tag_down == 'new' or tag_down == 'favorite' or tag_down == 'favourite' -%}
            {%- assign pdp_badge = tag_down | replace: 'bestseller', 'best seller' -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if pdp_badge != blank -%}
          <span class="kj-pdp-badge">{{ pdp_badge }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.subtitle != blank -%}
        <p class="kj-pdp-subtitle">{{ section.settings.subtitle }}</p>
      {%- elsif product.type != blank -%}
        <p class="kj-pdp-subtitle">{{ product.type | downcase }}</p>
      {%- endif -%}

      {%- assign rating = product.metafields.reviews.rating.value.rating -%}
      {%- assign rating_count = product.metafields.reviews.rating_count -%}
      <div class="kj-stars{% if rating == blank %} kj-stars--placeholder{% endif %}" aria-hidden="true">
        {%- assign filled = rating | default: 5 | round -%}
        {%- for i in (1..5) -%}
          <span class="kj-star{% if i <= filled %} kj-star--filled{% endif %}">&#9733;</span>
        {%- endfor -%}
        {%- if rating_count != blank -%}
          <span class="kj-star-count">({{ rating_count }}) reviews</span>
        {%- endif -%}
      </div>

      {%- form 'product', product, id: 'kj-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-kj-pdp-id>

        {%- unless product.has_only_default_variant -%}
          <p class="kj-pdp-shade-label">
            {{ product.options.first | downcase }}: <span data-kj-pdp-shade>{{ current_variant.title | downcase }}</span>
          </p>

          <!-- Shade dropdown -->
          {%- comment -%} Chip shows the real shade color: center-crop of the shade's swatch-smear photo when one exists. {%- endcomment -%}
          {%- assign current_chip = current_variant.featured_image -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' and media.alt == current_variant.title -%}
              {%- assign msrc = media.preview_image.src | default: '' -%}
              {%- if msrc contains 'LipMacro' or msrc contains 'lipmacro' -%}
                {%- assign current_chip = media.preview_image -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- capture cur_hex -%}{% render 'kj-shade-hex', shade: current_variant.title %}{%- endcapture -%}
          <div class="kj-pdp-dropdown">
            <span class="kj-pdp-dropdown-chip">
              {%- if cur_hex != blank -%}
                <span class="kj-pdp-swatch-blank" style="background: {{ cur_hex }}; width: 28px; height: 28px; display: block; border-radius: 50%;"></span>
              {%- elsif current_chip != blank -%}
                <img src="{{ current_chip | image_url: width: 56, height: 56, crop: 'center' }}" alt="" width="28" height="28" data-kj-pdp-chip>
              {%- endif -%}
            </span>
            <select data-kj-pdp-select aria-label="{{ product.options.first | escape }}">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}>{{ variant.title | downcase }}</option>
              {%- endfor -%}
            </select>
            <svg class="kj-pdp-dropdown-caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>

          <!-- Family tabs -->
          {%- assign family_lines = section.settings.shade_families | newline_to_br | split: '<br />' -%}
          {%- if section.settings.shade_families != blank -%}
            <div class="kj-pdp-families" data-kj-families>
              <button type="button" class="kj-pdp-family kj-family-active" data-kj-family-tab data-family="all">all</button>
              {%- for line in family_lines -%}
                {%- assign parts = line | split: ':' -%}
                {%- if parts.size == 2 -%}
                  <button type="button" class="kj-pdp-family" data-kj-family-tab data-family="{{ parts[0] | strip | downcase }}">{{ parts[0] | strip | downcase }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Shade chips -->
          <div class="kj-pdp-swatches">
            {%- for variant in product.variants -%}
              {%- assign v_family = '' -%}
              {%- for line in family_lines -%}
                {%- assign parts = line | split: ':' -%}
                {%- if parts.size == 2 -%}
                  {%- assign members = parts[1] | split: ',' -%}
                  {%- for m in members -%}
                    {%- assign m_clean = m | strip | downcase -%}
                    {%- assign v_clean = variant.title | downcase -%}
                    {%- if m_clean == v_clean -%}{%- assign v_family = parts[0] | strip | downcase -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign v_chip = variant.featured_image -%}
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' and media.alt == variant.title -%}
                  {%- assign msrc = media.preview_image.src | default: '' -%}
                  {%- if msrc contains 'LipMacro' or msrc contains 'lipmacro' -%}
                    {%- assign v_chip = media.preview_image -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- capture v_hex -%}{% render 'kj-shade-hex', shade: variant.title %}{%- endcapture -%}
              <button
                type="button"
                class="kj-pdp-swatch{% if variant == current_variant %} kj-pdp-swatch--active{% endif %}"
                data-kj-pdp-swatch
                data-id="{{ variant.id }}"
                data-title="{{ variant.title | escape }}"
                data-price="{{ variant.price | money }}"
                data-available="{{ variant.available }}"
                data-family="{{ v_family }}"
                {% if variant.featured_image != blank %}data-image="{{ variant.featured_image | image_url: width: 1400 }}"{% endif %}
                {% if v_chip != blank %}data-chip="{{ v_chip | image_url: width: 56, height: 56, crop: 'center' }}"{% endif %}
                aria-label="{{ variant.title | escape }}"
                {% unless variant.available %}data-soldout="true"{% endunless %}
              >
                {%- if v_hex != blank -%}
                  <span class="kj-pdp-swatch-blank" style="background: {{ v_hex }};"></span>
                {%- elsif v_chip != blank -%}
                  <img src="{{ v_chip | image_url: width: 56, height: 56, crop: 'center' }}" alt="" width="28" height="28" loading="lazy">
                {%- else -%}
                  <span class="kj-pdp-swatch-blank"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <!-- Qty + add to cart -->
        <div class="kj-pdp-buy-row">
          <div class="kj-pdp-qty">
            <button type="button" data-kj-qty-minus aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" data-kj-qty aria-label="Quantity">
            <button type="button" data-kj-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="kj-pdp-add" data-kj-pdp-add {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              add to cart - <span data-kj-pdp-price>{{ current_variant.price | money }}</span>
            {%- else -%}
              sold out
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <!-- Accordions -->
      <div class="kj-pdp-accordions">
        <details class="kj-pdp-acc" open>
          <summary>details</summary>
          <div class="kj-pdp-acc-body">{{ product.description }}</div>
        </details>
        {%- if product.metafields.custom.ingredients != blank -%}
          <details class="kj-pdp-acc">
            <summary>ingredients</summary>
            <div class="kj-pdp-acc-body">{{ product.metafields.custom.ingredients | metafield_tag }}</div>
          </details>
        {%- endif -%}
        {%- if product.metafields.custom.how_to_use != blank -%}
          <details class="kj-pdp-acc">
            <summary>how to use</summary>
            <div class="kj-pdp-acc-body">{{ product.metafields.custom.how_to_use | metafield_tag }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.shipping_text != blank -%}
          <details class="kj-pdp-acc">
            <summary>shipping &amp; returns</summary>
            <div class="kj-pdp-acc-body">{{ section.settings.shipping_text }}</div>
          </details>
        {%- endif -%}
      </div>

      <!-- Benefits icons -->
      {%- if section.settings.benefits != blank -%}
        {%- assign benefit_items = section.settings.benefits | split: ',' -%}
        {%- assign benefit_icons = section.settings.benefit_icons | split: ',' -%}
        <div class="kj-pdp-benefits">
          {%- for b in benefit_items -%}
            <div class="kj-pdp-benefit">
              <span class="kj-pdp-benefit-icon{% if section.settings.benefit_icons != blank %} kj-pdp-benefit-icon--img{% endif %}">
                {%- if benefit_icons.size > 0 and section.settings.benefit_icons != blank -%}
                  {%- assign icon_index = forloop.index0 | modulo: benefit_icons.size -%}
                  <img src="{{ benefit_icons[icon_index] | strip }}" alt="" width="52" height="52" loading="lazy">
                {%- else -%}
                  {%- assign glyph = forloop.index0 | modulo: 3 -%}
                  {%- if glyph == 0 -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                  {%- elsif glyph == 1 -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c4 4.5 6 7.5 6 10.5a6 6 0 1 1-12 0C6 10.5 8 7.5 12 3z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 14c4-1 6-3 7-7 3 1 7 4 7 8a7 7 0 0 1-14 0z"/><path d="M5 21c2-3 4-4 7-5"/></svg>
                  {%- endif -%}
                {%- endif -%}
              </span>
              <span class="kj-pdp-benefit-label">{{ b | strip | downcase }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    if (window.__kjPdpDelegated) return;
    window.__kjPdpDelegated = true;

    function selectVariant(root, data) {
      var idInput = root.querySelector('[data-kj-pdp-id]');
      if (idInput) idInput.value = data.id;
      var price = root.querySelector('[data-kj-pdp-price]');
      if (price && data.price) price.textContent = data.price;
      var shade = root.querySelector('[data-kj-pdp-shade]');
      if (shade) shade.textContent = (data.title || '').toLowerCase();
      var chip = root.querySelector('[data-kj-pdp-chip]');
      if (chip && data.chip) chip.src = data.chip;
      var sel = root.querySelector('[data-kj-pdp-select]');
      if (sel) sel.value = data.id;
      root.querySelectorAll('[data-kj-pdp-swatch]').forEach(function (s) {
        s.classList.toggle('kj-pdp-swatch--active', s.dataset.id === data.id);
      });
      var add = root.querySelector('[data-kj-pdp-add]');
      if (add) {
        var ok = data.available !== 'false';
        add.disabled = !ok;
        if (!ok) add.textContent = 'sold out';
      }
      // Gallery: filter thumbs to this shade if any match, else show all
      var thumbs = root.querySelectorAll('[data-kj-pdp-thumb]');
      var matches = [];
      thumbs.forEach(function (t) { if (t.dataset.alt === data.title) matches.push(t); });
      thumbs.forEach(function (t) {
        t.classList.toggle('kj-media-hidden', matches.length > 0 && t.dataset.alt !== data.title);
        t.classList.remove('kj-thumb-active');
      });
      var main = root.querySelector('[data-kj-pdp-main]');
      var first = matches[0] || thumbs[0];
      if (main && first) { main.src = first.dataset.full; first.classList.add('kj-thumb-active'); }
      else if (main && data.image) { main.src = data.image; }
      var url = new URL(window.location.href);
      url.searchParams.set('variant', data.id);
      window.history.replaceState({}, '', url.toString());
    }

    document.addEventListener('click', function (e) {
      var root;
      var swatch = e.target.closest('[data-kj-pdp-swatch]');
      if (swatch) {
        root = swatch.closest('.kj-pdp');
        selectVariant(root, swatch.dataset);
        return;
      }
      var thumb = e.target.closest('[data-kj-pdp-thumb]');
      if (thumb) {
        root = thumb.closest('.kj-pdp');
        var main = root.querySelector('[data-kj-pdp-main]');
        if (main) main.src = thumb.dataset.full;
        root.querySelectorAll('[data-kj-pdp-thumb]').forEach(function (t) {
          t.classList.toggle('kj-thumb-active', t === thumb);
        });
        return;
      }
      var tab = e.target.closest('[data-kj-family-tab]');
      if (tab) {
        root = tab.closest('.kj-pdp');
        var fam = tab.dataset.family;
        root.querySelectorAll('[data-kj-family-tab]').forEach(function (t) {
          t.classList.toggle('kj-family-active', t === tab);
        });
        root.querySelectorAll('[data-kj-pdp-swatch]').forEach(function (s) {
          s.classList.toggle('kj-media-hidden', fam !== 'all' && s.dataset.family !== fam);
        });
        return;
      }
      var minus = e.target.closest('[data-kj-qty-minus]');
      var plus = e.target.closest('[data-kj-qty-plus]');
      if (minus || plus) {
        root = (minus || plus).closest('.kj-pdp');
        var qty = root.querySelector('[data-kj-qty]');
        var v = parseInt(qty.value, 10) || 1;
        qty.value = Math.max(1, v + (plus ? 1 : -1));
      }
    });

    document.addEventListener('change', function (e) {
      var sel = e.target.closest('[data-kj-pdp-select]');
      if (!sel) return;
      var root = sel.closest('.kj-pdp');
      var swatch = root.querySelector('[data-kj-pdp-swatch][data-id="' + sel.value + '"]');
      if (swatch) selectVariant(root, swatch.dataset);
    });
  })();

  (function () {
    /* PDP Virtual Try-On: camera + MediaPipe face mesh, lazy-loaded on first
       open only. Lip fill uses the active variant's mapped shade color. */
    if (window.__kjPdpVto) return;
    window.__kjPdpVto = { camera: null, faceMesh: null, color: null, loading: false };
    var S = window.__kjPdpVto;

    function els() {
      var modal = document.querySelector('[data-kj-vto-modal]');
      if (!modal) return null;
      return {
        modal: modal,
        video: modal.querySelector('[data-kj-vto-video]'),
        canvas: modal.querySelector('[data-kj-vto-canvas]'),
        loading: modal.querySelector('[data-kj-vto-loading]'),
        shadeName: modal.querySelector('[data-kj-vto-shadename]')
      };
    }

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.crossOrigin = 'anonymous';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function onResults(results) {
      var e = els();
      if (!e) return;
      var canvas = e.canvas, ctx = canvas.getContext('2d');
      e.loading.style.display = 'none';
      if (canvas.width !== e.video.videoWidth) {
        canvas.width = e.video.videoWidth;
        canvas.height = e.video.videoHeight;
      }
      ctx.save();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(results.image, 0, 0, canvas.width, canvas.height);
      if (results.multiFaceLandmarks && results.multiFaceLandmarks.length > 0) {
        var lm = results.multiFaceLandmarks[0];
        var outer = [61, 146, 91, 181, 84, 17, 314, 405, 321, 375, 291, 409, 270, 269, 267, 0, 37, 39, 40, 185, 61];
        var inner = [78, 95, 88, 178, 87, 14, 317, 402, 318, 324, 308, 415, 310, 311, 312, 13, 82, 81, 80, 191, 78];
        ctx.globalCompositeOperation = 'multiply';
        ctx.fillStyle = (S.color || '#C98A78') + '80';
        ctx.beginPath();
        outer.forEach(function (idx, i) {
          var pt = lm[idx];
          if (i === 0) ctx.moveTo(pt.x * canvas.width, pt.y * canvas.height);
          else ctx.lineTo(pt.x * canvas.width, pt.y * canvas.height);
        });
        inner.forEach(function (idx, i) {
          var pt = lm[idx];
          if (i === 0) ctx.moveTo(pt.x * canvas.width, pt.y * canvas.height);
          else ctx.lineTo(pt.x * canvas.width, pt.y * canvas.height);
        });
        ctx.fill('evenodd');
        ctx.globalCompositeOperation = 'source-over';
      }
      ctx.restore();
    }

    function startAR() {
      var e = els();
      if (!e || S.loading) return;
      var boot = function () {
        if (!S.faceMesh) {
          S.faceMesh = new window.FaceMesh({ locateFile: function (f) { return 'https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/' + f; } });
          S.faceMesh.setOptions({ maxNumFaces: 1, refineLandmarks: true, minDetectionConfidence: 0.5, minTrackingConfidence: 0.5 });
          S.faceMesh.onResults(onResults);
          S.camera = new window.Camera(e.video, {
            onFrame: function () { return S.faceMesh.send({ image: e.video }); },
            width: 480,
            height: 640
          });
        }
        S.camera.start();
      };
      if (window.FaceMesh && window.Camera) { boot(); return; }
      S.loading = true;
      Promise.all([
        loadScript('https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js'),
        loadScript('https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js')
      ]).then(function () { S.loading = false; boot(); })
        .catch(function () { S.loading = false; if (e.loading) e.loading.textContent = 'CAMERA UNAVAILABLE'; });
    }

    document.addEventListener('click', function (ev) {
      var open = ev.target.closest('[data-kj-vto-open]');
      if (open) {
        var e = els();
        if (!e) return;
        e.modal.classList.add('active');
        e.loading.style.display = 'block';
        var first = e.modal.querySelector('.kj-pdpvto-swatch.active') || e.modal.querySelector('.kj-pdpvto-swatch');
        if (first) {
          S.color = first.dataset.kjVtoColor;
          if (e.shadeName) e.shadeName.textContent = (first.dataset.kjVtoName || '').toLowerCase();
        }
        startAR();
        return;
      }
      var close = ev.target.closest('[data-kj-vto-close]');
      var backdrop = ev.target.matches && ev.target.matches('[data-kj-vto-modal]');
      if (close || backdrop) {
        var e2 = els();
        if (!e2) return;
        e2.modal.classList.remove('active');
        if (S.camera) S.camera.stop();
        return;
      }
      var sw = ev.target.closest('.kj-pdpvto-swatch');
      if (sw) {
        var e3 = els();
        e3.modal.querySelectorAll('.kj-pdpvto-swatch').forEach(function (x) { x.classList.remove('active'); });
        sw.classList.add('active');
        S.color = sw.dataset.kjVtoColor;
        if (e3.shadeName) e3.shadeName.textContent = (sw.dataset.kjVtoName || '').toLowerCase();
      }
    });
  })();
</script>

<style>
