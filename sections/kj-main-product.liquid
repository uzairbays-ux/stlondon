{% render 'kj-card-styles' %}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="kj-pdp" id="kj-pdp-{{ section.id }}">
  <div class="kj-pdp-container">

    <!-- Left: scrolling gallery -->
    <div class="kj-pdp-gallery">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div class="kj-pdp-media">
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media | image_url: width: 1200 }}"
                alt="{{ media.alt | escape }}"
                class="kj-pdp-img"
                {% if forloop.first %}data-kj-pdp-main{% endif %}
                width="1200"
                height="{{ 1200 | divided_by: media.aspect_ratio | round }}"
                {% unless forloop.first %}loading="lazy"{% endunless %}
              >
            {%- else -%}
              {{ media | media_tag }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="kj-pdp-media">{{ 'product-1' | placeholder_svg_tag: 'kj-pdp-placeholder' }}</div>
      {%- endif -%}
    </div>

    <!-- Right: sticky info -->
    <div class="kj-pdp-info-wrapper">
      <div class="kj-pdp-info">

        <div class="kj-pdp-title-row">
          <h1 class="kj-pdp-title">{{ product.title }}</h1>
          <div class="kj-pdp-price-wrap">
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="kj-pdp-compare-price" data-kj-pdp-compare>{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span class="kj-pdp-price" data-kj-pdp-price>{{ current_variant.price | money }}</span>
          </div>
        </div>

        {%- assign rating = product.metafields.reviews.rating.value.rating -%}
        {%- assign rating_count = product.metafields.reviews.rating_count -%}
        <div class="kj-stars{% if rating == blank %} kj-stars--placeholder{% endif %}" aria-hidden="true">
          {%- assign filled = rating | default: 5 | round -%}
          {%- for i in (1..5) -%}
            <span class="kj-star{% if i <= filled %} kj-star--filled{% endif %}">&#9733;</span>
          {%- endfor -%}
          {%- if rating_count != blank -%}
            <span class="kj-star-count">({{ rating_count }} reviews)</span>
          {%- endif -%}
        </div>

        <div class="kj-pdp-short-desc">{{ product.description | strip_html | truncatewords: 32 }}</div>

        {%- form 'product', product, id: 'kj-product-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-kj-pdp-id>

          {%- unless product.has_only_default_variant -%}
            <p class="kj-pdp-shade-label">
              {{ product.options.first | downcase }}: <strong data-kj-pdp-shade>{{ current_variant.title }}</strong>
            </p>
            <div class="kj-pdp-swatches">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  class="kj-pdp-swatch{% if variant == current_variant %} kj-pdp-swatch--active{% endif %}"
                  data-kj-pdp-swatch
                  data-id="{{ variant.id }}"
                  data-title="{{ variant.title | escape }}"
                  data-price="{{ variant.price | money }}"
                  data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                  data-available="{{ variant.available }}"
                  {% if variant.featured_image != blank %}data-image="{{ variant.featured_image | image_url: width: 1200 }}"{% endif %}
                  aria-label="{{ variant.title | escape }}"
                  {% unless variant.available %}data-soldout="true"{% endunless %}
                >
                  {%- if variant.featured_image != blank -%}
                    <img src="{{ variant.featured_image | image_url: width: 72, height: 72, crop: 'center' }}" alt="" width="72" height="72" loading="lazy">
                  {%- else -%}
                    <span class="kj-pdp-swatch-blank"></span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <button type="submit" name="add" class="kj-pdp-add" data-kj-pdp-add {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}add to bag{%- else -%}sold out{%- endif -%}
          </button>
        {%- endform -%}

        <div class="kj-pdp-accordions">
          <details class="kj-pdp-acc" open>
            <summary>details</summary>
            <div class="kj-pdp-acc-body">{{ product.description }}</div>
          </details>
          {%- if product.metafields.custom.how_to_use != blank -%}
            <details class="kj-pdp-acc">
              <summary>how to use</summary>
              <div class="kj-pdp-acc-body">{{ product.metafields.custom.how_to_use | metafield_tag }}</div>
            </details>
          {%- endif -%}
          {%- if product.metafields.custom.ingredients != blank -%}
            <details class="kj-pdp-acc">
              <summary>ingredients</summary>
              <div class="kj-pdp-acc-body">{{ product.metafields.custom.ingredients | metafield_tag }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.shipping_text != blank -%}
            <details class="kj-pdp-acc">
              <summary>shipping &amp; returns</summary>
              <div class="kj-pdp-acc-body">{{ section.settings.shipping_text }}</div>
            </details>
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    if (window.__kjPdpDelegated) return;
    window.__kjPdpDelegated = true;
    document.addEventListener('click', function (e) {
      var swatch = e.target.closest('[data-kj-pdp-swatch]');
      if (!swatch) return;
      var root = swatch.closest('.kj-pdp');
      root.querySelectorAll('[data-kj-pdp-swatch]').forEach(function (s) {
        s.classList.toggle('kj-pdp-swatch--active', s === swatch);
      });
      var idInput = root.querySelector('[data-kj-pdp-id]');
      if (idInput) idInput.value = swatch.dataset.id;
      var price = root.querySelector('[data-kj-pdp-price]');
      if (price) price.textContent = swatch.dataset.price;
      var compare = root.querySelector('[data-kj-pdp-compare]');
      if (compare) {
        compare.textContent = swatch.dataset.compare || '';
        compare.style.display = swatch.dataset.compare ? '' : 'none';
      }
      var shade = root.querySelector('[data-kj-pdp-shade]');
      if (shade) shade.textContent = swatch.dataset.title;
      var main = root.querySelector('[data-kj-pdp-main]');
      if (main && swatch.dataset.image) main.src = swatch.dataset.image;
      var add = root.querySelector('[data-kj-pdp-add]');
      if (add) {
        var available = swatch.dataset.available === 'true';
        add.disabled = !available;
        add.textContent = available ? 'add to bag' : 'sold out';
      }
      var url = new URL(window.location.href);
      url.searchParams.set('variant', swatch.dataset.id);
      window.history.replaceState({}, '', url.toString());
    });
  })();
</script>

<style>
  .kj-pdp {
    background: {{ section.settings.bg_color }};
  }

  .kj-pdp-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 20px 70px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 50px;
    align-items: start;
  }

  .kj-pdp-gallery {
    display: grid;
    gap: 14px;
  }

  .kj-pdp-media {
    position: relative;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
  }

  .kj-pdp-img,
  .kj-pdp-placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .kj-pdp-info-wrapper {
    position: sticky;
    top: 90px;
  }

  .kj-pdp-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .kj-pdp-title {
    font-family: var(--font-heading--family);
    font-size: 26px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .kj-pdp-price-wrap {
    white-space: nowrap;
    font-size: 18px;
  }

  .kj-pdp-compare-price {
    color: #999;
    margin-right: 6px;
  }

  .kj-pdp .kj-stars {
    margin: 10px 0 0;
  }

  .kj-pdp .kj-star {
    font-size: 13px;
  }

  .kj-pdp .kj-star-count {
    font-size: 12px;
  }

  .kj-pdp-short-desc {
    font-size: 13px;
    line-height: 1.65;
    color: #444;
    margin: 16px 0 22px;
  }

  .kj-pdp-shade-label {
    font-size: 12px;
    text-transform: lowercase;
    color: #555;
    margin: 0 0 10px;
  }

  .kj-pdp-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .kj-pdp-swatch {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #ddd;
    padding: 2px;
    background: #fff;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .kj-pdp-swatch img,
  .kj-pdp-swatch-blank {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: #eee;
  }

  .kj-pdp-swatch--active {
    border: 2px solid #000;
  }

  .kj-pdp-swatch[data-soldout] {
    opacity: 0.35;
  }

  .kj-pdp-add {
    font-family: var(--font-heading--family);
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 100px;
    padding: 16px;
    font-size: 14px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .kj-pdp-add:hover:not(:disabled) {
    opacity: 0.85;
  }

  .kj-pdp-add:disabled {
    background: #999;
    cursor: not-allowed;
  }

  .kj-pdp-accordions {
    margin-top: 30px;
    border-top: 1px solid #e5d8d8;
  }

  .kj-pdp-acc {
    border-bottom: 1px solid #e5d8d8;
  }

  .kj-pdp-acc summary {
    font-family: var(--font-heading--family);
    font-size: 13px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.5px;
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .kj-pdp-acc summary::-webkit-details-marker {
    display: none;
  }

  .kj-pdp-acc summary::after {
    content: '+';
    font-size: 16px;
    font-weight: 400;
  }

  .kj-pdp-acc[open] summary::after {
    content: '\2212';
  }

  .kj-pdp-acc-body {
    font-size: 13px;
    line-height: 1.65;
    color: #444;
    padding: 0 0 16px;
  }

  @media screen and (max-width: 989px) {
    .kj-pdp-container {
      grid-template-columns: 1fr;
      gap: 26px;
      padding-top: 12px;
    }
    .kj-pdp-info-wrapper {
      position: static;
    }
    .kj-pdp-gallery {
      grid-auto-flow: column;
      grid-auto-columns: 85%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .kj-pdp-gallery::-webkit-scrollbar {
      display: none;
    }
    .kj-pdp-media {
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Main Product",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7efef"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns Text",
      "default": "<p>free uk shipping on orders over £40. easy returns within 30 days.</p>"
    }
  ]
}
{% endschema %}
