    max-width: 480px;
    text-align: center;
    color: #fff;
  }

  .kj-pdpvto-close {
    position: absolute;
    top: -42px;
    right: 0;
    font-size: 32px;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
  }

  .kj-pdpvto-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
  }

  .kj-pdpvto-video { display: none; }

  .kj-pdpvto-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
  }

  .kj-pdpvto-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
