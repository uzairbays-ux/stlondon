<div class="kj-split-editorial" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="kj-split-container">
    <div class="kj-split-card{% if section.settings.media_side == 'left' %} kj-split-flip{% endif %}">

      <div class="kj-split-text" style="background-color: {{ section.settings.card_bg }};">
        <div class="kj-split-text-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="kj-split-heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="kj-split-body">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="kj-split-btn">{{ section.settings.button_text }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="kj-split-media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: image_size: '1200x', loop: true, muted: true, autoplay: true, controls: false, class: 'kj-split-media-el' }}
        {%- elsif section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" class="kj-split-media-el" loading="lazy" width="1200" height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'kj-split-placeholder' }}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  .kj-split-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-split-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border-radius: 8px;
  }

  .kj-split-flip .kj-split-text { order: 2; }
  .kj-split-flip .kj-split-media { order: 1; }

  .kj-split-text {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
  }

  .kj-split-text-inner {
    max-width: 340px;
    text-align: center;
  }

  .kj-split-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.3;
    margin: 0 0 18px 0;
  }

  .kj-split-body {
    font-size: 13px;
    line-height: 1.6;
    color: #333;
    margin-bottom: 26px;
  }

  /* Same button spec as the hero (reference .action--primary) */
  .kj-split-btn {
    font-family: var(--font-heading--family);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.75rem;
    padding: 11px 22px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #393939;
    background: #fff;
    border: 1px solid #393939;
    border-radius: 0;
    text-decoration: none;
    text-transform: lowercase;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
  }

  .kj-split-btn:hover {
    background: #393939;
    border-color: #393939;
    color: #fff;
  }

  .kj-split-media {
    position: relative;
    aspect-ratio: 1 / 1;
    min-height: 0;
  }

  .kj-split-media-el,
  .kj-split-media video,
  .kj-split-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kj-split-placeholder {
    fill: #ccc;
    background: #eee;
  }

  @media screen and (max-width: 767px) {
    .kj-split-card {
      grid-template-columns: 1fr;
    }
    .kj-split-flip .kj-split-text { order: 1; }
    .kj-split-flip .kj-split-media { order: 2; }
    .kj-split-text {
      padding: 40px 24px;
    }
    .kj-split-media {
      aspect-ratio: 1 / 1;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Split Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE SUMMER LOOK"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#91715B"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>recreate this flushed and contoured look featuring our best sellers.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (optional, replaces image)"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Media Side",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F5F2"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "KJ Split Editorial"
    }
  ]
}
{% endschema %}
