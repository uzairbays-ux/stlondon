<div class="kj-shop-category" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="kj-category-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="kj-category-heading" style="color: {{ section.settings.heading_color | default: section.settings.text_color }};">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="kj-category-list">
      {%- for block in section.blocks -%}
        <div class="kj-category-item" {{ block.shopify_attributes }}>
          {%- liquid
            assign cat_url = block.settings.link | default: block.settings.collection.url | default: '#'
            assign ext_src = block.settings.external_image_url | strip
            if ext_src != blank and ext_src contains '//'
            elsif ext_src != blank
              assign ext_src = ext_src | asset_url
            endif
          -%}
          <a href="{{ cat_url }}" class="kj-category-link">
            <div class="kj-category-image-wrap{% if section.settings.tile_aspect == 'landscape' %} kj-category-image-wrap--landscape{% endif %}">
              {%- if ext_src != blank -%}
                <img src="{{ ext_src }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="kj-category-image">
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700, height: 700, crop: 'center' }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="kj-category-image" width="700" height="700">
              {%- elsif block.settings.collection.image != blank -%}
                <img src="{{ block.settings.collection.image | image_url: width: 700, height: 700, crop: 'center' }}" alt="{{ block.settings.title | escape }}" loading="lazy" class="kj-category-image" width="700" height="700">
              {%- else -%}
                <div class="kj-category-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
            {%- unless section.settings.hide_titles -%}
              <span class="kj-category-title" style="color: {{ section.settings.text_color }};">
                {{ block.settings.title | default: block.settings.collection.title | default: 'Category' }}
              </span>
            {%- endunless -%}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .kj-category-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .kj-category-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 40px;
  }

  .kj-category-list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr);
    gap: 20px;
  }

  .kj-category-image-wrap.kj-category-image-wrap--landscape {
    aspect-ratio: 4 / 3;
    background: transparent;
  }

  .kj-category-item {
    width: 100%;
  }

  .kj-category-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .kj-category-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 12px;
    background: #ffffff;
  }

  .kj-category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .kj-category-link:hover .kj-category-image {
    transform: scale(1.05);
  }

  .kj-category-placeholder svg {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-category-title {
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.3px;
    text-align: center;
    display: block;
  }

  @media screen and (max-width: 767px) {
    .kj-category-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Shop by Category",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#91715B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "hide_titles",
      "label": "Hide titles (labels baked in images)",
      "default": false
    },
    {
      "type": "select",
      "id": "tile_aspect",
      "label": "Tile aspect",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 4:3" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Optional)"
        },
        {
          "type": "text",
          "id": "external_image_url",
          "label": "Image URL or asset filename (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KJ Shop by Category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
