<div class="kj-video-carousel" id="kj-videos-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="kj-videos-container">

    <div class="kj-videos-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="kj-videos-heading" style="color: {{ section.settings.heading_color | default: section.settings.text_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="kj-videos-subheading" style="color: {{ section.settings.text_color }};">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="kj-videos-track-wrap">
      <div class="kj-videos-track">
        {%- for block in section.blocks -%}
          <div class="kj-video-card" {{ block.shopify_attributes }}>
            <div class="kj-video-media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: image_size: '600x', loop: true, muted: true, controls: false, preload: 'metadata', class: 'kj-video-el' }}
                <button type="button" class="kj-video-play" aria-label="Play video">
                  <svg class="kj-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="kj-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
                </button>
              {%- elsif block.settings.external_video_url != blank -%}
                <video
                  class="kj-video-el"
                  src="{{ block.settings.external_video_url }}"
                  {% if block.settings.external_poster_url != blank %}poster="{{ block.settings.external_poster_url }}"{% endif %}
                  loop muted playsinline preload="metadata"
                ></video>
                <button type="button" class="kj-video-play" aria-label="Play video">
                  <svg class="kj-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="kj-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
                </button>
              {%- elsif block.settings.cover_image != blank -%}
                <img src="{{ block.settings.cover_image | image_url: width: 600 }}" alt="{{ block.settings.cover_image.alt | escape }}" class="kj-video-el" loading="lazy" width="600" height="{{ 600 | divided_by: block.settings.cover_image.aspect_ratio | round }}">
              {%- elsif block.settings.external_poster_url != blank -%}
                <img src="{{ block.settings.external_poster_url }}" alt="" class="kj-video-el" loading="lazy" width="600" height="1000">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'kj-video-placeholder' }}
              {%- endif -%}
            </div>

            {%- assign vid_product = block.settings.product -%}
            {%- if vid_product != blank -%}
              <a href="{{ vid_product.url }}" class="kj-video-product">
                {%- if vid_product.featured_image != blank -%}
                  <img src="{{ vid_product.featured_image | image_url: width: 120 }}" alt="{{ vid_product.title | escape }}" class="kj-video-product-img" loading="lazy" width="120" height="{{ 120 | divided_by: vid_product.featured_image.aspect_ratio | round }}">
                {%- endif -%}
                <span class="kj-video-product-info">
                  <span class="kj-video-product-title">{{ vid_product.title }}</span>
                  <span class="kj-video-product-price">{{ vid_product.price | money }}</span>
                </span>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..4) -%}
            <div class="kj-video-card">
              <div class="kj-video-media">
                {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'kj-video-placeholder' }}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('kj-videos-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.kj-video-card').forEach(function (card) {
      var video = card.querySelector('video');
      var btn = card.querySelector('.kj-video-play');
      if (!video || !btn) return;
      btn.addEventListener('click', function () {
        if (video.paused) {
          root.querySelectorAll('video').forEach(function (v) {
            if (v !== video) { v.pause(); v.closest('.kj-video-card').classList.remove('kj-video-playing'); }
          });
          video.play();
          card.classList.add('kj-video-playing');
        } else {
          video.pause();
          card.classList.remove('kj-video-playing');
        }
      });
    });
  })();
</script>

<style>
  .kj-videos-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-videos-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .kj-videos-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 8px 0;
  }

  .kj-videos-subheading {
    font-size: 14px;
    letter-spacing: 0.5px;
    margin: 0;
    opacity: 0.7;
  }

  .kj-videos-track-wrap {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .kj-videos-track-wrap::-webkit-scrollbar {
    display: none;
  }

  .kj-videos-track {
    display: flex;
    gap: 16px;
  }

  .kj-video-card {
    flex: 0 0 20%;
    min-width: 240px;
    position: relative;
  }

  .kj-video-media {
    position: relative;
    width: 100%;
    aspect-ratio: 9/16;
    background-color: #f4f4f4;
    overflow: hidden;
    border-radius: 8px;
  }

  .kj-video-el,
  .kj-video-media video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kj-video-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-video-play {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .kj-video-play:hover {
    transform: scale(1.1);
  }

  .kj-icon-pause { display: none; }
  .kj-video-playing .kj-icon-pause { display: block; }
  .kj-video-playing .kj-icon-play { display: none; }

  .kj-video-product {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 64px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 6px;
    padding: 6px;
    text-decoration: none;
    color: #000;
  }

  .kj-video-product-img {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .kj-video-product-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .kj-video-product-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kj-video-product-price {
    font-size: 11px;
    opacity: 0.7;
  }

  @media screen and (max-width: 767px) {
    .kj-video-card {
      flex: 0 0 60%;
      min-width: 200px;
      scroll-snap-align: start;
    }
    .kj-videos-track {
      scroll-snap-type: x mandatory;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Video Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN ON SOCIAL"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#91715B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "external_video_url",
          "label": "External Video URL (mp4)"
        },
        {
          "type": "text",
          "id": "external_poster_url",
          "label": "External Poster URL"
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover Image (fallback if no video)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured Product"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "KJ Video Carousel",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
