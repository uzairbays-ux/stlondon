{%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
{%- assign is_grid = false -%}
{%- if section.settings.layout == 'grid' -%}{%- assign is_grid = true -%}{%- endif -%}

<div class="kj-product-slider{% if is_grid %} kj-layout-grid{% endif %}" id="kj-slider-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="kj-slider-container">

    <div class="kj-slider-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="kj-slider-heading" style="color: {{ section.settings.heading_color | default: section.settings.text_color }};">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="kj-slider-header-actions">
        {%- if section.settings.shop_all_link != blank -%}
          <a href="{{ section.settings.shop_all_link }}" class="kj-slider-shop-all" style="color: {{ section.settings.text_color }};">Shop All</a>
        {%- endif -%}
        {%- unless is_grid -%}
          <div class="kj-slider-arrows">
            <button type="button" class="kj-slider-arrow" data-kj-prev aria-label="Previous products">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="kj-slider-arrow" data-kj-next aria-label="Next products">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        {%- endunless -%}
      </div>
    </div>

    {%- if tab_blocks.size > 0 -%}
      {%- comment -%} A single tab is pointless UI — show the pills only when there's a real choice. {%- endcomment -%}
      {%- if tab_blocks.size > 1 -%}
        <div class="kj-slider-tabs" role="tablist">
          {%- for block in tab_blocks -%}
            <button
              type="button"
              class="kj-slider-tab{% if forloop.first %} kj-tab-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-kj-tab="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in tab_blocks -%}
        <div class="kj-slider-track-wrap{% unless forloop.first %} kj-track-hidden{% endunless %}" data-kj-panel="{{ forloop.index0 }}">
          <div class="kj-slider-track">
            {%- assign tab_collection = block.settings.collection -%}
            {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
              {%- for product in tab_collection.products limit: section.settings.product_limit -%}
                {% render 'kj-product-card', product: product, show_secondary_image: section.settings.show_secondary_image, text_color: section.settings.text_color %}
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="kj-product-card">
                  <div class="kj-product-image-wrap">
                    {{ 'product-' | append: i | placeholder_svg_tag: 'kj-product-placeholder' }}
                  </div>
                  <div class="kj-product-info" style="color: {{ section.settings.text_color }};">
                    <h3 class="kj-product-title">Sample Product</h3>
                    <div class="kj-product-price"><span class="kj-price-regular">$24.00</span></div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="kj-slider-track-wrap">
        <div class="kj-slider-track">
          {%- assign collection = section.settings.collection -%}
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: section.settings.product_limit -%}
              {% render 'kj-product-card', product: product, show_secondary_image: section.settings.show_secondary_image, text_color: section.settings.text_color %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="kj-product-card">
                <div class="kj-product-image-wrap">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'kj-product-placeholder' }}
                </div>
                <div class="kj-product-info" style="color: {{ section.settings.text_color }};">
                  <h3 class="kj-product-title">Sample Product</h3>
                  <div class="kj-product-price"><span class="kj-price-regular">$24.00</span></div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    /* Delegated once at document level: survives theme DOM morphing,
       which destroys listeners bound directly to section nodes. */
    if (window.__kjSliderDelegated) return;
    window.__kjSliderDelegated = true;

    document.addEventListener('click', function (e) {
      var tab = e.target.closest('[data-kj-tab]');
      if (tab) {
        var root = tab.closest('.kj-product-slider');
        var index = tab.getAttribute('data-kj-tab');
        root.querySelectorAll('[data-kj-tab]').forEach(function (t) {
          t.classList.toggle('kj-tab-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        root.querySelectorAll('[data-kj-panel]').forEach(function (p) {
          p.classList.toggle('kj-track-hidden', p.getAttribute('data-kj-panel') !== index);
        });
        return;
      }

      var arrow = e.target.closest('[data-kj-prev], [data-kj-next]');
      if (arrow) {
        var slider = arrow.closest('.kj-product-slider');
        var track = slider.querySelector('.kj-slider-track-wrap:not(.kj-track-hidden)');
        if (!track) return;
        var card = track.querySelector('.kj-product-card');
        var step = card ? card.getBoundingClientRect().width + 20 : 300;
        var dir = arrow.hasAttribute('data-kj-prev') ? -1 : 1;
        track.scrollBy({ left: dir * step, behavior: 'smooth' });
      }
    });
  })();
</script>

<style>
  .kj-slider-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-slider-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 30px;
  }

  .kj-slider-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }

  .kj-slider-shop-all {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: underline;
  }

  .kj-slider-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .kj-slider-arrows {
    display: flex;
    gap: 8px;
  }

  .kj-slider-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #000;
    background: transparent;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kj-slider-arrow:hover {
    background: #000;
    color: #fff;
  }

  @media screen and (max-width: 767px) {
    .kj-slider-arrows {
      display: none;
    }
  }

  .kj-slider-tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }

  .kj-slider-tab {
    font-family: var(--font-heading--family);
    background: transparent;
    border: 1px solid #000;
    color: #000;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 8px 20px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kj-slider-tab:hover {
    background: #f4f4f4;
  }

  .kj-slider-tab.kj-tab-active {
    background: #000;
    color: #fff;
  }

  .kj-track-hidden {
    display: none;
  }

  .kj-slider-track-wrap {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .kj-slider-track-wrap::-webkit-scrollbar {
    display: none;
  }

  .kj-slider-track {
    display: flex;
    gap: 20px;
  }

  .kj-product-card {
    flex: 0 0 25%;
    min-width: 280px;
  }

  /* Grid layout: Kylie-style static wrapped grid instead of a slider */
  .kj-layout-grid .kj-slider-track-wrap {
    overflow-x: visible;
  }

  .kj-layout-grid .kj-slider-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px 20px;
  }

  .kj-layout-grid .kj-product-card {
    min-width: 0;
  }

  .kj-product-card-link {
    text-decoration: none;
    display: block;
  }

  .kj-product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.1;
    background-color: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .kj-product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .kj-product-placeholder {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  .kj-img-secondary {
    opacity: 0;
  }

  .kj-product-card:hover .kj-img-secondary {
    opacity: 1;
  }

  .kj-product-card:hover .kj-img-primary {
    opacity: 0;
  }

  .kj-shades-inline {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    font-size: 11px;
    color: #333;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-swatch-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 8px 0;
    min-height: 16px;
  }

  .kj-swatch {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #DDD2C8;
  }

  .kj-swatch-more {
    font-size: 10px;
    color: #666;
  }

  .kj-stars {
    display: flex;
    align-items: center;
    gap: 1px;
    margin-top: 4px;
    line-height: 1;
  }

  .kj-star {
    font-size: 11px;
    color: #DDD2C8;
  }

  .kj-star--filled {
    color: #000;
  }

  .kj-stars--placeholder .kj-star--filled {
    color: #333;
  }

  .kj-star-count {
    font-size: 10px;
    color: #666;
    margin-left: 4px;
  }

  .kj-vto-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #000;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 8px;
    z-index: 2;
  }

  .kj-quick-add-wrap {
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    padding: 10px;
    transition: bottom 0.3s ease;
    z-index: 2;
  }

  .kj-product-card:hover .kj-quick-add-wrap {
    bottom: 0;
  }

  .kj-quick-add-btn {
    font-family: var(--font-heading--family);
    width: 100%;
    background-color: #000;
    color: #fff;
    border: none;
    padding: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
  }

  .kj-quick-add-btn:hover {
    background-color: #333;
  }

  .kj-product-info {
    text-align: left;
  }

  .kj-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .kj-product-title {
    font-family: var(--font-heading--family);
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 5px 0;
    text-transform: lowercase;
    letter-spacing: 0.2px;
  }

  .kj-product-price {
    font-size: 13px;
    margin-bottom: 5px;
    white-space: nowrap;
  }

  .kj-price-compare {
    color: #999;
    margin-right: 5px;
  }

  .kj-product-shades {
    font-size: 11px;
    color: #666;
    margin: 0;
    text-transform: lowercase;
  }

  @media screen and (max-width: 767px) {
    .kj-product-card {
      flex: 0 0 75%;
      min-width: 220px;
      scroll-snap-align: start;
    }
    .kj-slider-track {
      scroll-snap-type: x mandatory;
    }
    .kj-quick-add-wrap {
      display: none; /* Usually hide hover actions on mobile, or keep static */
    }
    .kj-layout-grid .kj-slider-track {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 12px;
    }
    .kj-layout-grid .kj-product-card {
      min-width: 0;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 989px) {
    .kj-layout-grid .kj-slider-track {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

{%- comment -%} Shared card styles render last so they win over the legacy card CSS above. {%- endcomment -%}
{% render 'kj-card-styles' %}

{% schema %}
{
  "name": "KJ Product Slider",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when no tabs are added below."
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All Link"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Product Limit",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#91715B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "KJ Product Slider"
    }
  ]
}
{% endschema %}
