{% render 'kj-card-styles' %}

<div
  class="kj-recs"
  data-kj-recs
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
  style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="kj-recs-container">
      <h2 class="kj-recs-heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <div class="kj-recs-grid">
        {%- for rec in recommendations.products -%}
          {% render 'kj-product-card', product: rec, show_secondary_image: true, text_color: '#000000' %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.__kjRecsInit) return;
    window.__kjRecsInit = true;
    function load() {
      document.querySelectorAll('[data-kj-recs]:not([data-kj-loaded])').forEach(function (el) {
        el.setAttribute('data-kj-loaded', '1');
        fetch(el.dataset.url)
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var fresh = doc.querySelector('[data-kj-recs]');
            if (fresh && fresh.innerHTML.trim()) el.innerHTML = fresh.innerHTML;
          })
          .catch(function () {});
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', load);
    } else {
      load();
    }
  })();
</script>

<style>
  .kj-recs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .kj-recs-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 28px 0;
  }

  .kj-recs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px 20px;
  }

  @media screen and (max-width: 989px) {
    .kj-recs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 12px;
    }
  }
</style>

{% schema %}
{
  "name": "KJ Recommendations",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOU MAY ALSO LIKE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#91715B"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products",
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F5F2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "KJ Recommendations"
    }
  ]
}
{% endschema %}
